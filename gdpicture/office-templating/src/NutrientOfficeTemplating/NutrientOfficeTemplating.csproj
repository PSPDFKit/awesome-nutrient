<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NutrientOfficeTemplating</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GdPicture.API" Version="14.4.7" />
  </ItemGroup>

  <!-- Templates are read at runtime. The Web SDK already picks up the .json models
       as Content implicitly, so only the Office binaries are declared here. -->
  <ItemGroup>
    <Content Include="Templates\*.docx;Templates\*.xlsx;Templates\*.pptx"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Templates\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
