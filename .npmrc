# Refuse to resolve package versions published less than 15 days ago.
# Requires npm 11.10.0+; older npm versions warn and ignore this setting.
min-release-age=15

# TODO(2026-08-18): every min-release-age-exclude entry in the example .npmrc
# files (and each minimumReleaseAgeExclude list in a pnpm-workspace.yaml) only
# exists because the pinned security-remediation versions were published inside
# the cooldown window; the youngest of them leaves the window on 2026-08-18.
# After that date, remove the exclusions and relax the exact brace-expansion
# override pins (1.1.18 / 2.1.4 / 5.0.9) back to ranged floors.
