# Refuse to resolve package versions published less than 15 days ago.
# Requires npm 11.10.0+; older npm warns "Unknown project config" and ignores
# this setting, and npm ci installs the locked versions regardless.
min-release-age=15

# Fail loudly (instead of silently skipping the cooldown) when the npm in use
# predates min-release-age support; see "engines" in package.json.
engine-strict=true
