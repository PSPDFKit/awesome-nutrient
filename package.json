{
  "name": "awesome-nutrient",
  "private": true,
  "engines": {
    "node": "^20.17.0 || >=22.9.0",
    "npm": ">=11.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.1",
    "@eslint/js": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "playwright": "^1.57.0"
  },
  "scripts": {
    "format": "biome check --unsafe --write .",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "test:dependency-policy": "node --test .github/scripts/*.test.mjs"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
