# Refuse to resolve package versions published less than 15 days ago.
# Requires npm 11.17.0+: min-release-age landed in npm 11.10.0, but the
# exclusions below need 11.17.0+. npm 11.10.0-11.16.x enforces the cooldown
# while ignoring the exclusions, so it fails to resolve the pinned
# security-remediation versions.
min-release-age=15

# Allow the security-remediation versions already pinned in this example.
min-release-age-exclude[]=@emnapi/runtime
min-release-age-exclude[]=@next/*
min-release-age-exclude[]=brace-expansion
min-release-age-exclude[]=js-yaml
min-release-age-exclude[]=next
min-release-age-exclude[]=postcss
